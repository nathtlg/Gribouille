<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToggleGroup?>

<MenuBar xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="iut.gon.gribouille.controleurs.MenusController">
    <menus>
        <Menu text="Dessin">
            <items>
                <MenuItem text="Charger" onAction="#onCharger" />
                <MenuItem text="Sauvegarder" onAction="#onSauvegarder" />
                <MenuItem text="Exporter"/>
                <SeparatorMenuItem />
                <MenuItem text="Quitter" onAction="#onQuitte"/>
                <MenuItem text="Effacer" onAction="#onEffacer" />
            </items>
        </Menu>
        <Menu text="Outils">
            <items>
                <Menu text="Epaisseur">
                    <items>
                        <RadioMenuItem text="1">
                            <toggleGroup>
                                <ToggleGroup fx:id="groupeEpaisseur" />
                            </toggleGroup>
                        </RadioMenuItem>
                        <RadioMenuItem text="2" toggleGroup="$groupeEpaisseur" />
                        <RadioMenuItem text="3" toggleGroup="$groupeEpaisseur" />
                        <RadioMenuItem text="4" toggleGroup="$groupeEpaisseur" />
                        <RadioMenuItem text="5" toggleGroup="$groupeEpaisseur" />
                        <RadioMenuItem text="6" toggleGroup="$groupeEpaisseur" />
                        <RadioMenuItem text="7" toggleGroup="$groupeEpaisseur" />
                        <RadioMenuItem text="8" toggleGroup="$groupeEpaisseur" />
                        <RadioMenuItem text="9" toggleGroup="$groupeEpaisseur" />
                    </items>
                </Menu>
                <RadioMenuItem fx:id="menuCrayon" text="Crayon">
                    <toggleGroup>
                        <ToggleGroup fx:id="groupeOutil" />
                    </toggleGroup>
                </RadioMenuItem>
                <RadioMenuItem fx:id="menuEtoile" text="Etoile" toggleGroup="$groupeOutil" />
            </items>
        </Menu>
        <Menu text="Aide">
            <items>
                <MenuItem text="À propos" />
            </items>
        </Menu>
    </menus>
</MenuBar>