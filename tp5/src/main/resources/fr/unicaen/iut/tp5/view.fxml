<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.unicaen.iut.tp5.ControleurDemineur"
            prefHeight="600.0"
            prefWidth="800.0">

    <top>
        <VBox>

            <MenuBar>

                <menus>

                    <Menu text="Jeu">
                        <items>
                            <MenuItem text="Quitter"/>
                        </items>
                    </Menu>

                    <Menu text="Difficulté">

                        <items>

                            <fx:define>
                                <ToggleGroup fx:id="niveau"/>
                            </fx:define>

                            <RadioMenuItem text="Facile"
                                           userData="10;10;10"
                                           toggleGroup="$niveau"
                                           selected="true"/>

                            <RadioMenuItem text="Moyen"
                                           userData="20;20;50"
                                           toggleGroup="$niveau"/>

                            <RadioMenuItem text="Difficile"
                                           userData="30;20;100"
                                           toggleGroup="$niveau"/>

                        </items>

                    </Menu>

                </menus>

            </MenuBar>

            <HBox spacing="20">

                <Label text="Nombre d'inconnues">
                    <graphic>
                        <TextField fx:id="NbInconnues"
                                   editable="false"
                                   focusTraversable="false"/>
                    </graphic>
                </Label>

                <Label text="Nombre de marques">
                    <graphic>
                        <TextField fx:id="NbMarques"
                                   editable="false"
                                   focusTraversable="false"/>
                    </graphic>
                </Label>

            </HBox>

        </VBox>
    </top>

    <center>

        <GridPane fx:id="grille"
                  gridLinesVisible="true"
                  maxWidth="Infinity"
                  maxHeight="Infinity"
                  prefWidth="800"
                  prefHeight="600"/>

    </center>

</BorderPane>